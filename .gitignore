# ==============================================================================
# NeuroScan AI — .gitignore Configuration
# ==============================================================================

# Environment and Secrets (Never commit or push)
.env
.env.*
*.env
*.env.*

# Python Virtual Environments & Dependencies
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python Caches, Bytecode & Testing
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node.js Dependencies, Logs & Build Outputs
node_modules/
dist/
build/
coverage/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Model Checkpoints & Large Binary Weights (Never commit)
*.pth
*.pt
*.ckpt
*.h5
*.keras
*.onnx
*.pkl
*.joblib
*.bin
*.safetensors
ai-service/models/*
!ai-service/models/.gitkeep
ai-service/calibration/data_cache/

# Medical Datasets & Imaging Archives (Never commit)
datasets/
dataset/
data/
OriginalDataset/
external_test_cohort/
research/datasets/
*.dcm
*.nii
*.nii.gz

# Research Working Folders, Audit Archives & Backups
research/
NEUROSCAN_CODEX_AUDIT/
NEUROSCAN_CODEX_AUDIT.zip
research.zip
.backup_stage_b/
scratch/
screenshots/
docs/
CHANGELOG.md

# Temporary Uploads & Generated Visualizations
uploads/
tmp/
temp/
heatmaps/
generated_heatmaps/
*.gradcam.png
*.ig.png

# Sensitive Credentials, Certificates & Configuration
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account.json

# Operating System & IDE Artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/

# Build caches & Log files
*.log
*.tmp
.cache/
