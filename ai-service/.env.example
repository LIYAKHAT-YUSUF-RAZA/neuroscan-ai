# AI Service Configuration
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=5001
PORT=5001
FLASK_ENV=production
FLASK_DEBUG=0

# Path to the trained PyTorch checkpoint
MODEL_CHECKPOINT_PATH=models/best_hybrid_model.pth

# Cloud download URL for best_hybrid_model.pth (used during Render build if checkpoint is missing)
# Example: https://github.com/<username>/<repo>/releases/download/v1.0.0/best_hybrid_model.pth
# Or Hugging Face: https://huggingface.co/<username>/<repo>/resolve/main/best_hybrid_model.pth
MODEL_DOWNLOAD_URL=

# Optional: Expected SHA-256 checksum for verification
MODEL_EXPECTED_SHA256=676fefe87d63ab727fe9b3451e94d86b056082651bbe858ca52bb56ae8fcdf06
MODEL_EXPECTED_SIZE_BYTES=211853875
