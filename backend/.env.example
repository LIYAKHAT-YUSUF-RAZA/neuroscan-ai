# Express Backend Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# Frontend client URL for CORS (comma-separated if multiple allowed origins)
# Example for Render production: https://neuroscan-frontend.onrender.com,http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173,https://neuroscan-frontend.onrender.com

# Python AI Microservice URL (public Render URL or local URL)
# Example for Render production: https://neuroscan-ai-service.onrender.com
FLASK_AI_URL=http://127.0.0.1:5001

# MongoDB Connection URI (e.g. MongoDB Atlas M0 cluster)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/alzheimer_db?retryWrites=true&w=majority
# If omitted or invalid, the backend runs gracefully in stateless mode
MONGODB_URI=mongodb://127.0.0.1:27017/alzheimer_db
